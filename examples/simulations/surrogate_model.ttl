@prefix : <http://example.org/sis-planner/surrogate_model#> .
@prefix t: <http://example.org/sis-planner/types#> .
@prefix ex: <http://example.org/sis-planner/production#> .
@prefix SiS: <http://www.semanticweb.org/reif/ontologies/SiS#> .
@prefix VDI3633: <http://www.semanticweb.org/reif/ontologies/VDI3633#> .
@prefix DINEN61360: <http://www.w3id.org/hsu-aut/DINEN61360#> .
@prefix CSS: <http://www.w3id.org/hsu-aut/css#> .
@prefix CaSk: <http://www.w3id.org/hsu-aut/cask#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Fictional example: reduced-order surrogate model that predicts stresses on the mesh.
# Fast, but less accurate and less mature.

:SurrogateModel a VDI3633:Simulation ;
    rdfs:label "Surrogate model for stresses" ;
    SiS:isSimulationFor ex:BracketDesign ;
    VDI3633:comprisesExperiment :Experiment .

:Experiment a VDI3633:SimulationExperiment ;
    VDI3633:hasSimulationRun :Run .

:Run a VDI3633:SimulationRun ;
    CSS:requiresCapability :SurrogateModelCapability ;
    VDI3633:isExecutedWith :Environment ;
    VDI3633:hasInputData :Mesh, :Material ;
    VDI3633:hasSimulationResultData :Stress .

:Environment a VDI3633:SimulationEnvironment ;
    CSS:providesCapability :SurrogateModelCapability ;
    SiS:hasQualityCriteria :LeadTime, :SimTime, :ResultAccuracy, :TRL .

:SurrogateModelCapability a CaSk:ProvidedCapability .

:Mesh a VDI3633:InputData ;
    SiS:hasDataElement :Mesh_DE .
:Mesh_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:Mesh_TD .

:Material a VDI3633:InputData ;
    SiS:hasDataElement :Material_DE .
:Material_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:Material_TD .

:Stress a VDI3633:SimulationResultData ;
    SiS:hasDataElement :Stress_DE .
:Stress_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:Stress_TD .

:LeadTime a SiS:QualityCriteria ; SiS:hasDataElement :LeadTime_DE .
:LeadTime_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:LeadTime_TD ;
    DINEN61360:has_Instance_Description :LeadTime_ID .
:LeadTime_ID a DINEN61360:Instance_Description, DINEN61360:Real ;
    DINEN61360:Value 0.95 ; DINEN61360:Logic_Interpretation "=" ; DINEN61360:Expression_Goal "Assurance" .

:SimTime a SiS:QualityCriteria ; SiS:hasDataElement :SimTime_DE .
:SimTime_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:SimTime_TD ;
    DINEN61360:has_Instance_Description :SimTime_ID .
:SimTime_ID a DINEN61360:Instance_Description, DINEN61360:Real ;
    DINEN61360:Value 1.0 ; DINEN61360:Logic_Interpretation "=" ; DINEN61360:Expression_Goal "Assurance" .

:ResultAccuracy a SiS:QualityCriteria ; SiS:hasDataElement :ResultAccuracy_DE .
:ResultAccuracy_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:ResultAccuracy_TD ;
    DINEN61360:has_Instance_Description :ResultAccuracy_ID .
:ResultAccuracy_ID a DINEN61360:Instance_Description, DINEN61360:Real ;
    DINEN61360:Value 0.5 ; DINEN61360:Logic_Interpretation "=" ; DINEN61360:Expression_Goal "Assurance" .

:TRL a SiS:QualityCriteria ; SiS:hasDataElement :TRL_DE .
:TRL_DE a DINEN61360:Data_Element ;
    DINEN61360:has_Type_Description t:TRL_TD ;
    DINEN61360:has_Instance_Description :TRL_ID .
:TRL_ID a DINEN61360:Instance_Description, DINEN61360:Real ;
    DINEN61360:Value 0.6 ; DINEN61360:Logic_Interpretation "=" ; DINEN61360:Expression_Goal "Assurance" .
